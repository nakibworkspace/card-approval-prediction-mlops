# =================================================================
# Card Approval Prediction - Environment Variables
# =================================================================

# AWS Configuration
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=card-approval-prediction-data-production

# PostgreSQL - API Database
POSTGRES_API_PASSWORD=api_password_change_me

# PostgreSQL - MLflow Database
POSTGRES_MLFLOW_PASSWORD=mlflow_password_change_me

# PostgreSQL - Airflow Database
POSTGRES_AIRFLOW_PASSWORD=airflow_password_change_me

# Redis
REDIS_PASSWORD=redis_password_change_me

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Grafana
GRAFANA_ADMIN_PASSWORD=admin_change_me

# Airflow
AIRFLOW_ADMIN_PASSWORD=admin_change_me
AIRFLOW_FERNET_KEY=fb0c3f8c8b3f4c5e8d9a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b8c7d6e
AIRFLOW_SECRET_KEY=secret_change_me

# GitHub (for deployment trigger from Airflow)
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO=your-username/card-approval-prediction

# Kaggle (for dataset download)
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key

# Docker Hub
DOCKER_HUB_USERNAME=your-dockerhub-username
DOCKER_HUB_TOKEN=your-dockerhub-token
