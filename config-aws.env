# =================================================================
# Card Approval Prediction - AWS Configuration
# =================================================================

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=card-approval-prediction-data-production

# MLflow Configuration
MLFLOW_TRACKING_URI=http://your-mlflow-server:5000
MLFLOW_S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
MODEL_NAME=card_approval_model
MODEL_STAGE=Production

# Docker Hub Configuration
DOCKER_HUB_USERNAME=your-dockerhub-username
DOCKER_HUB_TOKEN=your-dockerhub-token
IMAGE_NAME=card-approval-api

# Application Configuration
APP_NAME=Card Approval API
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# API Configuration
CORS_ORIGINS=*

# OpenTelemetry Tracing
OTEL_ENABLED=true
OTEL_SERVICE_NAME=card-approval-api
OTEL_EXPORTER_ENDPOINT=http://monitoring-instance-ip:4317
OTEL_SAMPLING_RATE=1.0

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# DVC Configuration
DVC_REMOTE=s3storage
DVC_REMOTE_URL=s3://card-approval-prediction-data-production/dvc-storage

# Drift Detection
DRIFT_DETECTION_ENABLED=true
DRIFT_THRESHOLD=0.3

# PostgreSQL Configuration
POSTGRES_API_PASSWORD=api_password_change_me
POSTGRES_MLFLOW_PASSWORD=mlflow_password_change_me

# Redis Configuration
REDIS_PASSWORD=redis_password_change_me
